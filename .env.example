# Public placeholder URL; replace it when the production domain is final.
NEXT_PUBLIC_SITE_URL=https://example.com

# MySQL / MariaDB connection. URL-encode special characters in the password.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/durvin_store"

# Admin credentials: set real values only in .env.local or deployment secrets.
ADMIN_USERNAME=replace_with_admin_username
ADMIN_PASSWORD=replace_with_strong_password
ADMIN_SESSION_SECRET=replace_with_long_random_secret

# Separate customer-session signing key. Do not reuse the admin session secret.
CUSTOMER_SESSION_SECRET=replace_with_another_long_random_secret
